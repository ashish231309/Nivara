<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Nivara asks for as little as it can, and every entry here is tied to a feature that exists.
      The AndroidX biometric library contributes the platform's biometric permission in the merged
      manifest, which is why biometric authentication works without a declaration here.

      PACKAGE_USAGE_STATS lets App Lock recognise which application is in the foreground. It is not
      a runtime permission and Nivara never calls requestPermissions() for it: it makes Nivara
      visible in Android's Usage Access list, and the onboarding screen only reads whether the
      grant exists and opens that settings screen.

      SYSTEM_ALERT_WINDOW is what allows the App Lock protection surface to be drawn above the
      application being protected. Android offers no other unprivileged way to do that: a
      full-screen activity cannot cover another application's window without taking over the task,
      and since API 29 starting one from the background is refused unless the application holds
      this very grant. It is not a runtime permission either, it is granted on Android's own
      overlay screen, and it entitles Nivara to draw a window and nothing else.

      REQUEST_IGNORE_BATTERY_OPTIMIZATIONS lets the onboarding screen show Android's own
      "ignore battery optimizations" confirmation for Nivara, so App Lock's service is not
      deferred while the user is inside a protected application. It only entitles Nivara to ask;
      the exemption itself is granted by the user, in Android's dialog or settings.

      FOREGROUND_SERVICE and FOREGROUND_SERVICE_SPECIAL_USE let the App Lock detection service
      keep running while Nivara is not on screen — the only situation in which protection means
      anything — announced by one quiet notification. The special-use type is declared with its
      subtype property on the service below, because no standard type describes an application
      lock, and nothing broader (accessibility, device admin) is used instead.

      RECEIVE_BOOT_COMPLETED lets the boot receiver read the user's stored "protection on"
      decision and restore the detection service after a restart. The receiver can do exactly
      that one thing and nothing else.

      POST_NOTIFICATIONS is the runtime permission for the one notification App Lock shows while
      protection runs. It is optional: when it is not granted, the service still runs and Android
      simply silences the notification.

      tools:ignore silences lint's protected-permission warning: these permissions are protected on
      purpose, and the user — not the application — is the one who grants them.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.SYSTEM_ALERT_WINDOW"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Package visibility (API 30+).
      Installed applications are hidden from a query by default. This declares exactly one intent
      signature — applications with a launcher entry point — which is the set App Lock offers to
      lock and the set the device's own launcher shows.
      QUERY_ALL_PACKAGES is deliberately not requested: it would expose every package on the device
      to answer a question about launcher entries, and Android treats the installed-application
      list as personal data.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".NivaraApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nivara"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Nivara"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Camouflage identities.

          Each alias is a second way of presenting and starting the same activity — the same
          component, the same task, the same data — under a different label and icon. Selecting an
          identity enables one of these and disables the others; nothing else about the application
          changes, and no second activity class exists.

          android:enabled="false" is what makes the shipped default Nivara's own identity: on a fresh
          install exactly one launcher entry is enabled, and the aliases stay out of the launcher
          until the user chooses one. The platform reports an untouched component as DEFAULT, so the
          manifest's declared state is the effective one, and the verifier pins that shape.

          An alias is never a hiding mechanism: the application stays installed under the same
          package, and Android's settings, the package manager and every management tool still list
          it. What the alias changes is the name and the icon on the home screen. See
          docs/camouflage/README.md.
        -->
        <activity-alias
            android:name=".CamouflageNotes"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_camouflage_notes"
            android:label="@string/camouflage_profile_notes_label"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".CamouflageCalculator"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_camouflage_calculator"
            android:label="@string/camouflage_profile_calculator_label"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".CamouflageWeather"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_camouflage_weather"
            android:label="@string/camouflage_profile_weather_label"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
          Nivara as the device's Home application.

          Apart from the application's own entry point below, this is the only exported component in
          the project, and it is exported for exactly one reason: Android can only start a Home
          application if it is allowed to start it from outside the application. The intent filter is the standard launcher contract and nothing else —
          ACTION_MAIN with CATEGORY_HOME and CATEGORY_DEFAULT — so a caller that can start this
          activity can do only what pressing Home does, which is show Nivara's launcher.

          What is deliberately absent: no custom actions, no data URIs, no permissions on the
          activity, and no handling of Intent extras. Nothing outside Nivara can ask it to launch an
          application, reveal a hidden one, or report any state.

          Nivara does not make itself the default Home application and does not change any system
          setting; the user selects it through Android's own Home settings, as documented in
          docs/launcher/README.md.
        -->
        <activity
            android:name=".ui.launcher.LauncherActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Nivara">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          App Lock detection and its protection surface.

          A foreground service of type specialUse: protection has to keep running while the user is
          inside the protected application, which is exactly when Nivara is not on screen, and the
          platform stops a plain background service within minutes of that. The type is specialUse
          because no standard foreground-service type describes an application lock, and the subtype
          property below states what the use actually is. The service shows one quiet, low
          -importance notification while it runs; it owns no logic of its own — it starts and stops
          the application-scoped monitor, which is the only monitoring loop in the process, and the
          application-scoped surface, which is the only overlay window.
          android:exported="false" keeps it private to Nivara: nothing outside the application may
          start it, stop it or observe it.
        -->
        <service
            android:name=".data.applock.AppLockDetectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="app-lock protection: watches the foreground application and presents the lock surface above protected applications" />
        </service>

        <!--
          Restores App Lock protection after a restart, when the user had left it on.

          Not exported: BOOT_COMPLETED and MY_PACKAGE_REPLACED are protected broadcasts that only
          the platform itself delivers, and the platform delivers them to non-exported receivers,
          while exported=false keeps every other application from talking to this component at
          all. The receiver reads the stored run-state and starts Nivara's own private service,
          and can do nothing else. See docs/applock/README.md.
        -->
        <receiver
            android:name=".data.applock.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
