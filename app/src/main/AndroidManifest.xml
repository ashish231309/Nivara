<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Nivara asks for as little as it can, and every entry here is tied to a feature that exists.
      The AndroidX biometric library contributes the platform's biometric permission in the merged
      manifest, which is why biometric authentication works without a declaration here.

      PACKAGE_USAGE_STATS is the one declaration. It is not a runtime permission and Nivara never
      calls requestPermissions() for it: it makes Nivara visible in Android's Usage Access list and
      lets a later stage read usage statistics, and the user grants it in Android's own settings.
      The preparation screen only reads whether the grant exists and opens that settings screen.
      tools:ignore silences lint's protected-permission warning: the permission is protected on
      purpose, and the user — not the application — is the one who grants it.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Package visibility (API 30+).
      Installed applications are hidden from a query by default. This declares exactly one intent
      signature — applications with a launcher entry point — which is the set App Lock offers to
      lock and the set the device's own launcher shows.
      QUERY_ALL_PACKAGES is deliberately not requested: it would expose every package on the device
      to answer a question about launcher entries, and Android treats the installed-application
      list as personal data.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".NivaraApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nivara"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Nivara"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          App Lock detection.
          A plain started service — not a foreground service — so it declares no foreground service
          type and needs no notification. It owns no logic of its own: it starts and stops the
          application-scoped monitor, which is the only monitoring loop in the process.
          android:exported="false" keeps it private to Nivara: nothing outside the application may
          start it, stop it or observe it. Why a foreground service is not used yet, and what the
          stage that presents the authentication prompt must decide, are recorded in
          docs/applock/README.md.
        -->
        <service
            android:name=".data.applock.AppLockDetectionService"
            android:exported="false" />
    </application>

</manifest>
