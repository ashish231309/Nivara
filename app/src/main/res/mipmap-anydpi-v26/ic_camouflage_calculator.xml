<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon for the calculator identity. Vector-only, like Nivara's own icon: the supported
  API range starts at 26, so no density-specific raster fallbacks are required.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_camouflage_calculator_background" />
    <foreground android:drawable="@drawable/ic_camouflage_calculator" />
    <monochrome android:drawable="@drawable/ic_camouflage_calculator" />
</adaptive-icon>
