<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Nivara uses a platform theme so that no XML-based UI library (for example Material
      Components) has to be shipped just to host a Compose-only activity.

      The first paint is the blue home header, so the status bar sits on blue and needs light
      icons: windowLightStatusBar stays false.
    -->
    <style name="Theme.Nivara" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
