<resources>
    <!-- Adaptive launcher icon background. -->
    <color name="ic_launcher_background">#0B3B36</color>

    <!--
      Adaptive launcher icon backgrounds for the camouflage identities. Ordinary colours on purpose:
      an identity is a name and an icon, and an icon that looked unusual would attract exactly the
      attention the harmless-looking one avoids.
    -->
    <color name="ic_camouflage_notes_background">#1F5F8B</color>
    <color name="ic_camouflage_calculator_background">#455A64</color>
    <color name="ic_camouflage_weather_background">#C77800</color>

    <!-- Window background used before the Compose UI draws its first frame. -->
    <color name="window_background">#FFFBFF</color>
</resources>
